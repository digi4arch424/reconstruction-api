# =============================================================================
# reconstruction-api — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# PostgreSQL — Supabase or any PostgreSQL 16+ instance with pgvector
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Redis — Upstash or any Redis 7+ instance
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# Object storage — Backblaze B2, Cloudflare R2, or AWS S3
S3_ENDPOINT=https://s3.[region].backblazeb2.com
S3_BUCKET=spatialrecon
S3_ACCESS_KEY=[keyID]
S3_SECRET_KEY=[applicationKey]
S3_REGION=us-west-004

# App
ENVIRONMENT=development
API_PORT=8000
